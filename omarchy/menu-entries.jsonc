  // predator-kb:begin
  // Predator 4-zone RGB keyboard, driven by the predator-kb CLI
  "keyboard": {"icon":"󰌌","label":"Keyboard RGB","description":"Predator keyboard LEDs: color, effect and brightness","aliases":["rgb","leds","keyboard"],"when":"test -w /dev/acer-gkbbl-0"},

  "keyboard.color": {"icon":"󰏘","label":"Color","description":"Solid color across the four zones"},
  "keyboard.color.custom": {"icon":"󰸌","label":"Custom...","action":"c=$(omarchy menu input 'Hex color (e.g. ff0055)') && predator-kb color \"$c\""},
  "keyboard.color.red": {"icon":"󰝤","label":"Red","action":"predator-kb color ff0000"},
  "keyboard.color.orange": {"icon":"󰝤","label":"Orange","action":"predator-kb color ff6600"},
  "keyboard.color.yellow": {"icon":"󰝤","label":"Yellow","action":"predator-kb color ffcc00"},
  "keyboard.color.green": {"icon":"󰝤","label":"Green","action":"predator-kb color 00ff44"},
  "keyboard.color.cyan": {"icon":"󰝤","label":"Cyan","action":"predator-kb color 00e5ff"},
  "keyboard.color.blue": {"icon":"󰝤","label":"Blue","action":"predator-kb color 0066ff"},
  "keyboard.color.purple": {"icon":"󰝤","label":"Purple","action":"predator-kb color 8000ff"},
  "keyboard.color.pink": {"icon":"󰝤","label":"Pink","action":"predator-kb color ff0080"},
  "keyboard.color.white": {"icon":"󰝤","label":"White","action":"predator-kb color ffffff"},
  "keyboard.color.gradient": {"icon":"󰸉","label":"Gradient","description":"One color per zone","action":"predator-kb color ff0055 ff6600 00e5ff 8000ff"},

  "keyboard.effect": {"icon":"󰌵","label":"Effect","description":"Animated backlight modes"},
  "keyboard.effect.wave": {"icon":"󰕙","label":"Wave","action":"predator-kb wave -s 5 -b 100"},
  "keyboard.effect.breath": {"icon":"󰌵","label":"Breath","action":"predator-kb breath 00e5ff -s 4 -b 100"},
  "keyboard.effect.neon": {"icon":"󰌶","label":"Neon","action":"predator-kb neon -s 3 -b 100"},
  "keyboard.effect.shift": {"icon":"󰑮","label":"Shift","action":"predator-kb shift 8000ff -s 5 -b 100"},
  "keyboard.effect.zoom": {"icon":"󰍉","label":"Zoom","action":"predator-kb zoom ff0055 -s 6 -b 100"},

  "keyboard.brightness": {"icon":"󰃞","label":"Brightness"},
  "keyboard.brightness.100": {"icon":"󰃞","label":"100%","action":"predator-kb brightness 100"},
  "keyboard.brightness.75": {"icon":"󰃝","label":"75%","action":"predator-kb brightness 75"},
  "keyboard.brightness.50": {"icon":"󰃝","label":"50%","action":"predator-kb brightness 50"},
  "keyboard.brightness.25": {"icon":"󰃝","label":"25%","action":"predator-kb brightness 25"},

  "keyboard.profile": {"icon":"󰆓","label":"Profiles"},
  "keyboard.profile.save": {"icon":"󰆓","label":"Save current...","action":"n=$(omarchy menu input 'Profile name') && predator-kb save \"$n\""},
  "keyboard.profile.load": {"icon":"󰉖","label":"Load...","action":"n=$(predator-kb list | tail -n +2 | tr -d ' ' | omarchy menu select 'Profile') && predator-kb load \"$n\""},

  "keyboard.off": {"icon":"󰐥","label":"Turn off","action":"predator-kb off"},
  "keyboard.on": {"icon":"󰃞","label":"Turn on","action":"predator-kb on"},
  // predator-kb:end
