  // predator-kb:begin
  // Teclado RGB do Predator (4 zonas, via CLI predator-kb)
  "keyboard": {"icon":"󰌌","label":"Teclado RGB","description":"LEDs do teclado Predator: cor, efeito e brilho","aliases":["rgb","leds","teclado"],"when":"test -w /dev/acer-gkbbl-0"},
  "keyboard.color": {"icon":"󰳓","label":"Cor","description":"Cor fixa nas quatro zonas"},
  "keyboard.color.custom": {"icon":"󰆏","label":"Personalizada...","action":"c=$(omarchy menu input 'Cor hex (ex: ff0055)') && predator-kb color \"$c\""},
  "keyboard.color.red": {"icon":"󰓶","label":"Vermelho","action":"predator-kb color ff0000"},
  "keyboard.color.orange": {"icon":"󰓶","label":"Laranja","action":"predator-kb color ff6600"},
  "keyboard.color.yellow": {"icon":"󰓶","label":"Amarelo","action":"predator-kb color ffcc00"},
  "keyboard.color.green": {"icon":"󰓶","label":"Verde","action":"predator-kb color 00ff44"},
  "keyboard.color.cyan": {"icon":"󰓶","label":"Ciano","action":"predator-kb color 00e5ff"},
  "keyboard.color.blue": {"icon":"󰓶","label":"Azul","action":"predator-kb color 0066ff"},
  "keyboard.color.purple": {"icon":"󰓶","label":"Roxo","action":"predator-kb color 8000ff"},
  "keyboard.color.pink": {"icon":"󰓶","label":"Rosa","action":"predator-kb color ff0080"},
  "keyboard.color.white": {"icon":"󰓶","label":"Branco","action":"predator-kb color ffffff"},
  "keyboard.color.gradient": {"icon":"󰶊","label":"Degrade","description":"Uma cor por zona","action":"predator-kb color ff0055 ff6600 00e5ff 8000ff"},
  "keyboard.effect": {"icon":"󱒚","label":"Efeito","description":"Animacoes do backlight"},
  "keyboard.effect.wave": {"icon":"󱒚","label":"Onda","action":"predator-kb wave -s 5 -b 100"},
  "keyboard.effect.breath": {"icon":"󰜋","label":"Respiracao","action":"predator-kb breath 00e5ff -s 4 -b 100"},
  "keyboard.effect.neon": {"icon":"󰖠","label":"Neon","action":"predator-kb neon -s 3 -b 100"},
  "keyboard.effect.shift": {"icon":"󰘏","label":"Deslizante","action":"predator-kb shift 8000ff -s 5 -b 100"},
  "keyboard.effect.zoom": {"icon":"󰂚","label":"Zoom","action":"predator-kb zoom ff0055 -s 6 -b 100"},
  "keyboard.brightness": {"icon":"󰃞","label":"Brilho"},
  "keyboard.brightness.100": {"icon":"󰃞","label":"100%","action":"predator-kb brightness 100"},
  "keyboard.brightness.75": {"icon":"󰃝","label":"75%","action":"predator-kb brightness 75"},
  "keyboard.brightness.50": {"icon":"󰃝","label":"50%","action":"predator-kb brightness 50"},
  "keyboard.brightness.25": {"icon":"󰃝","label":"25%","action":"predator-kb brightness 25"},
  "keyboard.profile": {"icon":"󰆐","label":"Perfis"},
  "keyboard.profile.save": {"icon":"󰆓","label":"Salvar atual...","action":"n=$(omarchy menu input 'Nome do perfil') && predator-kb save \"$n\""},
  "keyboard.profile.load": {"icon":"󰆑","label":"Carregar...","action":"n=$(predator-kb list | tail -n +2 | tr -d ' ' | omarchy menu select 'Perfil') && predator-kb load \"$n\""},
  "keyboard.off": {"icon":"󰖏","label":"Apagar","action":"predator-kb off"},
  "keyboard.on": {"icon":"󰃞","label":"Acender","action":"predator-kb on"},
  // predator-kb:end
